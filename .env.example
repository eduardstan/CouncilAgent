# Copy to `.env` and fill in values. `.env` is gitignored.

# OpenRouter — used by LiteLLMClient for openrouter/* model names.
# Free-tier models: openrouter/openai/gpt-oss-20b:free, openrouter/google/gemma-3-27b-it:free
OPENROUTER_API_KEY=

# Provider keys — read by LiteLLM when routing openai/*, anthropic/*, etc.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# Gate for tests/integration/ — set to 1 to enable real model calls.
RUN_INTEGRATION=0
