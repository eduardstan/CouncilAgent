# Copy to `.env` and fill in values. `.env` is gitignored.

# OpenRouter — used by council.models.OpenRouterClient
OPENROUTER_API_KEY=

# Provider keys — read directly by litellm when routing openai/*, anthropic/*, etc.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# Ollama — local daemon. Override only if not running on localhost:11434.
# OLLAMA_BASE_URL=http://localhost:11434

# Gate for tests/integration/ — set to 1 to enable real model calls in integration tests.
RUN_INTEGRATION=0
